          "required": true,
          "enum": "code_or_multi"
        },
        "origin": {
          "required": true,
          "enum": "lead_origin"
        },
        "lead_text": {
          "required": true
        },
        "lead_received": {
          "required": true,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "resolution": {
          "required": true,
          "enum": "lead_resolution"
        },
        "resolved_source_ids": {
          "fk_multi": "source_register.source_id"
        },
        "resolution_notes": {
          "required": true
        },
        "evidence": {},
        "resolved_date": {
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        }
